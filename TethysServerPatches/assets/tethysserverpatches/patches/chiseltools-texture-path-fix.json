[
  // chiseltools texture fix
  // fixed already in chiseltools 1.17.4+, so this patch is only needed for older versions.
  // blockswapper
  {
    "op": "Replace",
    "file": "chiseltools:itemtypes/blockswapper",
    "path": "/textures/wood/base",
    "value": "game:item/tool/handle",
    "condition": {
      "when": "TethysServerPatches_ChiselToolsLegacy",
      "isValue": true
    },
    "dependsOn": [
      {
        "modId": "chiseltools"
      }
    ]
  },
  {
    "op": "Replace",
    "file": "chiseltools:itemtypes/blockswapper",
    "path": "/textures/linen/base",
    "value": "game:block/cloth/linen/plain",
    "condition": {
      "when": "TethysServerPatches_ChiselToolsLegacy",
      "isValue": true
    },
    "dependsOn": [
      {
        "modId": "chiseltools"
      }
    ]
  },
