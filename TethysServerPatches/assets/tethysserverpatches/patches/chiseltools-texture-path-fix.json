[
  // game:item/tool/material/handle and game:item/tool/material/linen no longer exist in VS 1.22.
  // Handle moved to survival:item/tool/handle; linen (brush tips) maps to survival:block/cloth/linen/plain.

  // blockswapper
  { "op": "Replace", "file": "chiseltools:itemtypes/blockswapper", "path": "/textures/wood/base",   "value": "survival:item/tool/handle",          "dependsOn": [{ "modId": "chiseltools" }] },
  { "op": "Replace", "file": "chiseltools:itemtypes/blockswapper", "path": "/textures/linen/base",  "value": "survival:block/cloth/linen/plain",   "dependsOn": [{ "modId": "chiseltools" }] },

