[
  // Replicates aldiclasses patches when BaconBaconBacon is installed but bacon crop patching
  // is disabled.
  {
    "op": "addmerge",
    "path": "/dropsByType/*-11/1/dropModbyStat",
    "value": "produceDropRate",
    "file": "game:blocktypes/plant/crop/cabbage.json",
    "dependsOn": [
      { "modid": "aldiclasses" },
      { "modid": "baconbaconbacon" }
    ],
    "condition": { "when": "BaconBaconBacon_EnableBaconCrops", "isValue": false }
  },
  {
    "op": "addmerge",
    "path": "/dropsByType/*-12/1/dropModbyStat",
    "value": "produceDropRate",
    "file": "game:blocktypes/plant/crop/cabbage.json",
    "dependsOn": [
      { "modid": "aldiclasses" },
      { "modid": "baconbaconbacon" }
    ],
    "condition": { "when": "BaconBaconBacon_EnableBaconCrops", "isValue": false }
  }
]
