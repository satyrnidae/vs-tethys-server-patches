[
  // Swap the sleeper's skin-rendering behaviors for PlayerModelLib's own, the same way
  // the "Dead" mod does for its player-corpse entity (dead:patches/playermodellib-compat.json),
  // so non-Seraph models actually render instead of just carrying the right watched attributes.
  {
    "side": "Client",
    "file": "emberlandssleepers:entities/sleeper",
    "op": "replace",
    "path": "/client/behaviors/code=sleeperskin/code",
    "value": "PlayerModelLib:ExtraSkinnable",
    "dependsOn": [
      { "modid": "emberlandssleepers" },
      { "modid": "playermodellib" }
    ]
  },
  {
    "side": "Server",
    "file": "emberlandssleepers:entities/sleeper",
    "op": "replace",
    "path": "/server/behaviors/code=sleeperskin/code",
    "value": "PlayerModelLib:ExtraSkinnable",
    "dependsOn": [
      { "modid": "emberlandssleepers" },
      { "modid": "playermodellib" }
    ]
  },
  {
    "side": "Client",
    "file": "emberlandssleepers:entities/sleeper",
    "op": "add",
    "path": "/client/behaviors/-",
    "value": { "code": "PlayerModelLib:EntityTextureSourceBehavior" },
    "dependsOn": [
      { "modid": "emberlandssleepers" },
      { "modid": "playermodellib" }
    ]
  }
]
