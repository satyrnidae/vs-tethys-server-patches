[
  // New metal variants
  {
    "side": "Server",
    "file": "game:itemtypes/omokpiece.json",
    "op": "AddMerge",
    "path": "/variantgroups/0/states",
    "value": [ "silver", "electrum", "blackbronze", "brass" ],
    "condition": { "when": "TethysServerPatches_CustomOmokPieces", "isValue": true }
  },
  {
    "side": "Server",
    "file": "game:itemtypes/omokpiece.json",
    "op": "Add",
    "path": "/combustiblePropsByType/*-silver",
    "value": {
      "meltingPoint": 961,
      "meltingDuration": 30,
      "smeltedRatio": 20,
      "smeltedStack": { "type": "item", "code": "ingot-silver" }
    },
    "condition": { "when": "TethysServerPatches_CustomOmokPieces", "isValue": true }
  },
  {
    "side": "Server",
    "file": "game:itemtypes/omokpiece.json",
    "op": "Add",
    "path": "/combustiblePropsByType/*-electrum",
    "value": {
      "meltingPoint": 900,
      "meltingDuration": 30,
      "smeltedRatio": 20,
      "smeltedStack": { "type": "item", "code": "ingot-electrum" }
    },
    "condition": { "when": "TethysServerPatches_CustomOmokPieces", "isValue": true }
  },
  {
    "side": "Server",
    "file": "game:itemtypes/omokpiece.json",
    "op": "Add",
    "path": "/combustiblePropsByType/*-blackbronze",
    "value": {
      "meltingPoint": 900,
      "meltingDuration": 30,
      "smeltedRatio": 20,
      "smeltedStack": { "type": "item", "code": "ingot-blackbronze" }
    },
    "condition": { "when": "TethysServerPatches_CustomOmokPieces", "isValue": true }
  },
  {
    "side": "Server",
    "file": "game:itemtypes/omokpiece.json",
    "op": "Add",
    "path": "/combustiblePropsByType/*-brass",
    "value": {
      "meltingPoint": 900,
      "meltingDuration": 30,
      "smeltedRatio": 20,
      "smeltedStack": { "type": "item", "code": "ingot-brass" }
    },
    "condition": { "when": "TethysServerPatches_CustomOmokPieces", "isValue": true }
  },

  // Vanilla stone variants
  {
    "side": "Server",
